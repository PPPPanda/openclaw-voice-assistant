# Speech Core 配置
SPEECH_CORE_HOST=0.0.0.0
SPEECH_CORE_PORT=9001

# STT 配置
STT_ENGINE=faster-whisper
STT_MODEL=base
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
STT_LANGUAGE=auto

# TTS 配置
TTS_ENGINE=piper
TTS_VOICE=zh_CN-huayan-medium
TTS_SPEED=1.0

# TTS 云端备选 (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# VAD 配置
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=600
VAD_MIN_SPEECH_MS=300
VAD_MAX_SPEECH_S=8

# Discord 配置
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=http://localhost:18790
OPENCLAW_HOOKS_TOKEN=

# Voice Message Adapter (P0-2)
# 语音消息监听的频道 ID（逗号分隔，留空监听所有）
VOICE_MESSAGE_CHANNEL_IDS=
# 是否自动将转写结果发给 OpenClaw 处理
VOICE_AUTO_DISPATCH=true

# 日志
LOG_LEVEL=INFO
