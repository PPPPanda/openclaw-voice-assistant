{
  "name": "@openclaw/speech-core-plugin",
  "version": "0.1.0",
  "description": "OpenClaw Gateway plugin - Speech Core RPC client for STT/TTS/VAD",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "install": {
      "npmSpec": "@openclaw/speech-core-plugin",
      "defaultChoice": "npm"
    }
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "speech",
    "stt",
    "tts",
    "vad",
    "whisper",
    "piper"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PPPPanda/openclaw-voice-assistant.git",
    "directory": "gateway-plugins/speech-core"
  },
  "bugs": {
    "url": "https://github.com/PPPPanda/openclaw-voice-assistant/issues"
  },
  "homepage": "https://github.com/PPPPanda/openclaw-voice-assistant#readme",
  "dependencies": {
    "ws": "^8.16.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/ws": "^8.5.0",
    "@types/uuid": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
