{
  "id": "discord-voice",
  "name": "Discord Voice",
  "version": "0.1.0",
  "description": "Discord voice channel integration for OpenClaw - enables real-time voice conversations in Discord voice channels",
  "author": "OpenClaw Voice Assistant Team",
  "license": "MIT",
  "entry": "./dist/index.js",
  "kind": "channel",
  "dependencies": ["speech-core"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "botToken": {
        "type": "string",
        "description": "Discord Bot Token"
      },
      "guildId": {
        "type": "string",
        "description": "Discord Guild (Server) ID"
      },
      "defaultChannelId": {
        "type": "string",
        "description": "Default voice channel ID to join on startup (optional)"
      },
      "speechCoreEndpoint": {
        "type": "string",
        "default": "ws://localhost:9001/speech",
        "description": "Speech Core WebSocket endpoint"
      },
      "ttsProvider": {
        "type": "string",
        "enum": ["piper", "elevenlabs", "openai"],
        "default": "piper",
        "description": "TTS provider to use"
      },
      "sttLanguage": {
        "type": "string",
        "default": "auto",
        "description": "STT language (auto, zh, en, etc.)"
      }
    },
    "required": ["botToken", "guildId"]
  },
  "uiHints": {
    "botToken": {
      "label": "Discord Bot Token",
      "sensitive": true,
      "placeholder": "Your Discord bot token"
    },
    "guildId": {
      "label": "Guild (Server) ID",
      "placeholder": "Discord server ID"
    },
    "defaultChannelId": {
      "label": "Default Voice Channel ID",
      "placeholder": "Voice channel to auto-join (optional)"
    },
    "speechCoreEndpoint": {
      "label": "Speech Core Endpoint",
      "placeholder": "ws://localhost:9001/speech"
    },
    "ttsProvider": {
      "label": "TTS Provider"
    },
    "sttLanguage": {
      "label": "STT Language",
      "placeholder": "auto"
    }
  }
}
