# Discord Voice Pipeline - Environment Variables
# Copy to .env and fill in your values

# ── Required ─────────────────────────────────────────────────────────────────

# Discord Bot Token (must have Voice + Guild intents)
DISCORD_BOT_TOKEN=

# Discord Guild (server) ID
DISCORD_GUILD_ID=

# Discord Voice Channel ID to auto-join
DISCORD_CHANNEL_ID=

# ── LLM Configuration ───────────────────────────────────────────────────────

# LLM API Key (OpenAI, or any OpenAI-compatible provider)
LLM_API_KEY=

# LLM API endpoint (default: https://api.openai.com/v1)
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   Anthropic:   https://api.anthropic.com/v1  (needs compatible proxy)
#   Local LLM:   http://localhost:8080/v1
LLM_API_ENDPOINT=https://api.openai.com/v1

# Model name (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# ── Speech Core ──────────────────────────────────────────────────────────────

# Speech Core WebSocket endpoint (default: ws://localhost:9001/speech)
SPEECH_CORE_ENDPOINT=ws://localhost:9001/speech

# TTS provider: piper | elevenlabs | openai (default: piper)
TTS_PROVIDER=piper

# STT language: auto | en | zh | ja | ... (default: auto)
STT_LANGUAGE=auto

# ── Debug ────────────────────────────────────────────────────────────────────

# Set to any value to enable debug logging
# DEBUG=1
