{
  "name": "@openclaw/discord-voice",
  "version": "0.1.0",
  "description": "OpenClaw Gateway plugin - Discord voice channel integration for real-time voice conversations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rimraf dist",
    "start:voice": "npx tsx src/runner.ts",
    "prepublishOnly": "npm run build"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "@openclaw/discord-voice",
      "defaultChoice": "npm"
    }
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "discord",
    "voice",
    "voice-chat",
    "speech-to-text",
    "text-to-speech"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PPPPanda/openclaw-voice-assistant.git",
    "directory": "gateway-plugins/discord-voice"
  },
  "bugs": {
    "url": "https://github.com/PPPPanda/openclaw-voice-assistant/issues"
  },
  "homepage": "https://github.com/PPPPanda/openclaw-voice-assistant#readme",
  "dependencies": {
    "@discordjs/voice": "^0.17.0",
    "discord.js": "^14.14.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
